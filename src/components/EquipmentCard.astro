---
const { name, image, available } = Astro.props;
---
<div class="equipment-card stack-small">
  <img src={image} alt={name} />
  <h4>{name}</h4>
  <p class="status">
    <span class={available > 0 ? "status-dot" : "status-dot status-dot-empty"}></span>
    {available > 0 ? `${available} ledige` : "Alle udlånt"}
  </p>
</div>
