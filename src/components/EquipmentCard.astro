---
const { name, image, available, href } = Astro.props;
---

<a class="equipment-card stack-small" href={href}>
  <img src={image} alt="" />
  <h4>{name}</h4>
  <p class="status">
    <span class:list={["status-dot", { "status-dot-empty": !available }]}></span>
    {available ? "Ledig" : "Alle udlånt"}
  </p>
</a>