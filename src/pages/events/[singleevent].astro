---
import Layout from "../../layouts/Layout.astro";


export async function getStaticPaths() {
const url = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  
   const options = {
  headers: {
    apikey: key
  }
}
const tabel = "events";
const eventsResponse = await fetch(url + tabel, options);
const events = await eventsResponse.json();

    return events.map((event: any) => {
        return {
            params: { singleevent: event.slug },
            props: { event },
        };
    });
}

const { event } = Astro.props;
console.log("event", event);
---



<Layout title={event.name}>
  <!-- <section class="section container">
    <h1>{event.name}</h1>
    <img src={event.image} alt={event.name} />
  </section> -->
  <article class="studio theme-studios">

    <!-- HERO -->
    <section class="studio-hero container">
      <div class="studio-info">
        <h1 class="studio-title">{event.name}</h1>

        <p class="studio-description">{event.description}</p>

        <dl class="studio-facts">
          <div>
            <dt>Lokale</dt>
            <dd>{event.place}</dd>
          </div>
        </dl>

        <div class="button-row">
          <a class="btn btn-accent" href="#tilmelding">Tilmelding</a>
        </div>
      </div>

      <div class="studio-media">
        <a class="back-btn" href="/#studios" aria-label="Tilbage til studier">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6" />
          </svg>
        </a>
        <img class="studio-photo" src={event.image} alt={`${event.name}`}
          width="600" height="400" />
      </div>
    </section>
</Layout>

<style>
  /* ========== PAGE ========== */
  .studio {
    overflow-x: clip;
  }

  .btn-accent {
    background: var(--accent);
    color: #fff;
  }
  button.btn {
    font-family: inherit;
    cursor: pointer;
  }
  button.btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ========== HERO ========== */
  .studio-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: start;
    padding-block: 24px 96px;
  }

  .studio-media {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    padding: 160px 0 0 120px;
    background: url("/images/studios/blob-studios.png") no-repeat left top / contain;
  }
  .studio-info {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 24px;
  }

  .back-btn {
    position: absolute;
    top: 24px;
    left: 0;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 4px #fff;
  }
  .back-btn:hover {
    background: var(--maroon);
  }

  .studio-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-l);
  }

  .studio-title {
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 0.9;
  }

  .studio-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-s);
  }
  .studio-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--green);
  }
  .studio-status-dot.is-off {
    background: transparent;
    border: 1.5px solid var(--ink);
  }

  .studio-description {
    font-size: var(--text-l);
    max-width: 52ch;
  }

  .studio-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    margin: 0;
    padding-block: 20px;
    border-block: 1px solid var(--line);
  }
  .studio-facts dt,
  .practical dt {
    font-size: var(--text-s);
    opacity: 0.7;
  }
  .studio-facts dd,
  .practical dd {
    margin: 0;
    font-weight: 700;
  }

  /* ========== SHEET ========== */
  .studio-sheet {
    position: relative;
    display: grid;
    gap: 80px;
    margin-bottom: 120px;
    padding: 56px;
    background: #fff;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-panel);
  }

  /* ========== BOOKING ========== */
  .booking {
    display: grid;
    gap: 24px;
    padding: 48px;
    background: var(--pink-light-alt);
    border-radius: var(--radius-l);
  }
  .booking-title {
    font-size: var(--text-3xl);
    font-weight: 600;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  /* The radio button is invisible but covers the whole label */
  .day,
  .slot {
    position: relative;
  }
  .day input,
  .slot input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* Datoer/days */
  .days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 16px;
  }
  .day-box {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 20px 8px;
    background: #fff;
    border-radius: var(--radius-s);
  }
  .day-name {
    font-size: var(--text-s);
  }
  .day-date {
    font-family: var(--serif);
    font-size: var(--text-3xl);
    line-height: 1;
  }

  .day input:checked + .day-box {
    background: var(--accent);
    color: #fff;
  }
  .day input:checked + .day-box .dot {
    background: #fff;
  }
  .day input:disabled + .day-box {
    color: #999999;
  }
  .day input:disabled {
    cursor: not-allowed;
  }
  .day input:focus-visible + .day-box {
    outline: 3px solid var(--maroon);
    outline-offset: 3px;
  }

  /* Dots */
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .dot.is-full {
    background: transparent;
    border: 1.5px solid currentColor;
  }

  .booking-legend {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .booking-legend .dot:last-of-type {
    margin-left: 12px;
  }

  /* Times */
  .slots {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .slot-box {
    display: block;
    padding: 10px 24px;
    background: #fff;
    border: 2px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-weight: 700;
  }

  .slot input:checked + .slot-box {
    background: var(--accent);
    color: #fff;
  }
  .slot input:disabled + .slot-box {
    background: #eeeeee;
    border-color: #eeeeee;
    color: #999999;
    text-decoration: line-through;
  }
  .slot input:disabled {
    cursor: not-allowed;
  }
  .slot input:focus-visible + .slot-box {
    outline: 3px solid var(--maroon);
    outline-offset: 3px;
  }

  /* Summary */
  .booking-summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 32px;
    background: #fff;
    border-radius: var(--radius-m);
  }
  .booking-choice {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  /* ========== UDSTYR + PRAKTISK ========== */
  .studio-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
  }
  .studio-h2 {
    margin-bottom: 16px;
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .udstyr-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .udstyr-list li {
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .practical {
    display: grid;
    gap: 20px;
    margin: 0 0 32px;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 10px 32px 10px 10px;
    background: url("/images/blobs/frederick-small.svg") no-repeat center / 100% 100%;
    color: var(--maroon);
  }
  .contact-pill img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
  }
  .contact-pill:hover strong {
    text-decoration: underline;
  }

  /* ========== MOBILE ========== */
  @media (max-width: 800px) {
    .studio-hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .studio-info,
    .studio-media {
      grid-column: 1;
      grid-row: auto;
    }
    .studio-media {
      padding: 80px 0 0 32px;
    }

    .studio-sheet,
    .booking {
      padding: 24px;
    }
    .days {
      grid-template-columns: repeat(7, minmax(64px, 1fr));
      overflow-x: auto;
    }
    .studio-columns {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .studio-facts {
      gap: 24px;
    }
  }
</style>