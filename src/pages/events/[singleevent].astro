---
import Layout from "../../layouts/Layout.astro";


export async function getStaticPaths() {
const url = import.meta.env.PUBLIC_SUPABASE_URL;
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  
   const options = {
  headers: {
    apikey: key
  }
}
const tabel = "events";
const eventsResponse = await fetch(url + tabel, options);
const events = await eventsResponse.json();

    return events.map((event: any) => {
        return {
            params: { singleevent: event.slug },
            props: { event },
        };
    });
}

const { event } = Astro.props;
console.log("event", event);
---



<Layout title={event.name}>
  <!-- <section class="section container">
    <h1>{event.name}</h1>
    <img src={event.image} alt={event.name} />
  </section> -->
  <article class="studio theme-studios">

    <!-- HERO -->
    <section class="studio-hero container">
      <div class="studio-info">
        <h1 class="studio-title">{event.name}</h1>

        <p class="studio-description">{event.description}</p>

        <dl class="studio-facts">
          <div>
            <dt>Lokale</dt>
            <dd>{event.place}</dd>
          </div>
        </dl>

        <div class="button-row">
          <a class="btn btn-accent" href="#tilmelding">Tilmelding</a>
        </div>
      </div>

      <div class="studio-media">
        <a class="back-btn" href="/#studios" aria-label="Tilbage til studier">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6" />
          </svg>
        </a>
        <img class="studio-photo" src={event.image} alt={`${event.name}`}
          width="600" height="400" />
      </div>
    </section>
</Layout>

<style>
  /* ========== PAGE ========== */
  .studio {
    overflow-x: clip;
  }

  .btn-accent {
    background: var(--java);
    color: #fff;
  }
  button.btn {
    font-family: inherit;
    cursor: pointer;
  }
  button.btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* ========== HERO ========== */
  .studio-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: start;
    padding-block: 24px 96px;
  }

  .studio-media {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    padding: 160px 0 0 120px;
    background: url("/images/studios/blob-studios.png") no-repeat left top / contain;
  }
  .studio-info {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 24px;
  }

  .back-btn {
    position: absolute;
    top: 24px;
    left: 0;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--java);
    color: #fff;
    box-shadow: 0 0 0 4px #fff;
  }
  .back-btn:hover {
    background: #bfefea;
  }

  .studio-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-l);
  }

  .studio-title {
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 0.9;
  }

  

  .studio-description {
    font-size: var(--text-l);
    max-width: 52ch;
  }

  .studio-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    margin: 0;
    padding-block: 20px;
    border-block: 1px solid var(--line);
  }
  
  .studio-facts dd,
  .practical dd {
    margin: 0;
    font-weight: 700;
  }

  
 
 
  /* ========== UDSTYR + PRAKTISK ========== */

  .studio-h2 {
    margin-bottom: 16px;
    font-size: var(--text-2xl);
    font-weight: 600;
  }



  /* ========== MOBILE ========== */
  @media (max-width: 800px) {
    .studio-hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .studio-info,
    .studio-media {
      grid-column: 1;
      grid-row: auto;
    }
    .studio-media {
      padding: 80px 0 0 32px;
    }

    
    .studio-facts {
      gap: 24px;
    }
  }
</style>