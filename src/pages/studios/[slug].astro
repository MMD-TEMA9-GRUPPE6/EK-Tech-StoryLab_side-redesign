---
import Layout from "../layouts/Layout.astro";
import StudioPage from "../pages/StudioPage.astro";

export async function getStaticPaths() {
  const url = "https://ruljfiukbfuxeertrcfi.supabase.co/rest/v1/";
  const tabel = "studios";
  const key = "YOUR_KEY";

  const options = {
    headers: {
      apikey: key
    }
  };

  const response = await fetch(url + tabel, options);
  const studios = await response.json();

  return studios.map((studio: any) => {
    return {
      params: { singlepage: studio.slug },
      props: { studio },
    };
  });
}

interface Props {
  studio: any;
}

const { studio } = Astro.props;
---

<Layout title={studio.studio}>
  <StudioPage studio={studio} />
</Layout>