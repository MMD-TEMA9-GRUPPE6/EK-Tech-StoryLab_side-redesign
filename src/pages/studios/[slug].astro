---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const tabel = "studios";

  const options = {
    headers: {
      apikey: key,
    },
  };

  const response = await fetch(url + tabel, options);
  if (!response.ok) throw new Error(`Supabase svarede ${response.status}`);
  const studios = await response.json();

  return studios.map((studio: any) => {
    return {
      params: { slug: studio.slug },
      props: { studio },
    };
  });
}

interface Props {
  studio: any;
}

const { studio } = Astro.props;

// Same for all studios: change once here
const shared = {
  requirement: "Introkursus",
  maxHours: 4,
  hours: "Man–fre, 08–20",
  rules: "Ryd op efter dig",
  contact: {
    slug: "frederick",
    name: "Frederick",
    role: "Lab-manager",
    email: "frfr@ek.dk",
    phone: "46 46 04 42",
  },
};

// udstyr is comma-separated text in Supabase
const udstyr: string[] = (studio.udstyr ?? "")
  .split(",")
  .map((item: string) => item.trim())
  .filter(Boolean);

// MOCK: this week's days, computed at build time
const pad = (n: number) => String(n).padStart(2, "0");
const today = new Date();
const monday = new Date(today);
monday.setDate(today.getDate() - ((today.getDay() + 6) % 7));

const days = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(monday);
  d.setDate(monday.getDate() + i);
  const weekday = d.toLocaleDateString("da-DK", { weekday: "short" }).replace(".", "");
  return {
    value: `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`,
    weekday: weekday[0].toUpperCase() + weekday.slice(1),
    date: d.getDate(),
    label: d.toLocaleDateString("da-DK", { weekday: "long", day: "numeric", month: "short" }),
    full: i >= 5, // mock: weekend fully booked
  };
});

// MOCK: booked times
const slots = [
  { time: "08–10", booked: true },
  { time: "10–12", booked: false },
  { time: "12–14", booked: true },
  { time: "14–16", booked: false },
  { time: "16–18", booked: false },
  { time: "18–20", booked: false },
];
---

<Layout title={studio.studio}>
  <article class="studio theme-studios">
    <!-- HERO -->
    <section class="studio-hero container">
      <div class="studio-info cardcontainer">
        <h1 class="studio-title">{studio.studio}</h1>

        <p class="studio-status">
          <span class:list={["studio-status-dot", { "is-off": !studio.available }]}></span>
          {studio.available ? "Ledig nu" : "Optaget lige nu"}
        </p>

        <p class="studio-description">{studio.description}</p>

        <dl class="studio-facts">
          <div>
            <dt>Kapacitet</dt>
            <dd>{studio.capacity} personer</dd>
          </div>
          <div>
            <dt>Lokale</dt>
            <dd>{studio.room}</dd>
          </div>
          <div>
            <dt>Krav</dt>
            <dd>{shared.requirement}</dd>
          </div>
        </dl>

        <div class="button-row">
          <a class="btn btn-accent" href="#booking">
            Book studiet
          </a>
        </div>
      </div>

      <div class="studio-media has-blob">
        <img class="blob" src="/images/blobs/blob-studio.png" alt="" width="676" height="867" />
        <a class="back-btn" href="/#studios" aria-label="Tilbage til studier">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6" />
          </svg>
        </a>
        <img class="studio-photo" src={studio.image} alt={`${studio.studio}-studiet`} width="600" height="400" />
      </div>
    </section>

    <!-- SHEET -->
    <div class="studio-sheet container">
      <!-- BOOKING (mock) -->
      <section class="booking" id="booking" aria-labelledby="booking-title">
        <h2 class="booking-title" id="booking-title">
          Vælg tid
        </h2>

        <fieldset class="days">
          <legend class="sr-only">Vælg dag</legend>
          {days.map((day) => (
            <label class="day">
              <input type="radio" name="day" value={day.value} data-label={day.label} disabled={day.full} />
              <span class="day-box">
                <span class="day-name">{day.weekday}</span>
                <span class="day-date">{day.date}</span>
                <span class:list={["dot", { "is-full": day.full }]} aria-hidden="true"></span>
              </span>
            </label>
          ))}
        </fieldset>

        <p class="booking-legend small">
          <span class="dot" aria-hidden="true"></span> ledige tider
          <span class="dot is-full" aria-hidden="true"></span> fuldt booket
        </p>

        <fieldset class="slots">
          <legend class="sr-only">Vælg tidsrum</legend>
          {slots.map((slot) => (
            <label class="slot">
              <input type="radio" name="slot" value={slot.time} disabled={slot.booked} />
              <span class="slot-box">{slot.time}</span>
            </label>
          ))}
        </fieldset>

        <div class="booking-summary">
          <div>
            <p class="booking-choice" data-summary>
              Vælg dag og tid
            </p>
            <p class="small muted">
              {studio.studio}-studie · max {shared.maxHours} timer pr. booking
            </p>
          </div>
          <button class="btn btn-accent" type="button" data-confirm disabled>
            Bekræft booking
          </button>
        </div>
      </section>

      <!-- UDSTYR + PRAKTISK -->
      <div class="studio-columns">
        <section>
          <h2 class="studio-h2">Udstyr i studiet</h2>
          <ul class="udstyr-list">
            {udstyr.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="studio-h2">Praktisk</h2>
          <dl class="practical">
            <div>
              <dt>Åbningstider</dt>
              <dd>{shared.hours}</dd>
            </div>
            <div>
              <dt>Regler</dt>
              <dd>
                {shared.rules} · max {shared.maxHours} timer pr. booking
              </dd>
            </div>
          </dl>

          <a class="contact-pill" href={`mailto:${shared.contact.email}`}>
            <img src={`/images/team/${shared.contact.slug}.png`} alt="" width="80" height="80" />
            <span class="stack-small">
              <strong>Spørgsmål? Spørg {shared.contact.name}</strong>
              <span class="small">
                {shared.contact.role} · {shared.contact.email} · {shared.contact.phone}
              </span>
            </span>
          </a>
        </section>
      </div>
    </div>
  </article>
</Layout>

<script>
  // opdaterer booking summary og aktiverer knap, når både dag og tid er valgt, MEN GEMMER IKKE NOGET DATA <3
  const booking = document.querySelector("#booking");
  const summary = document.querySelector("[data-summary]");
  const confirmButton = document.querySelector("[data-confirm]");

  if (booking && summary && confirmButton) {
    booking.addEventListener("change", function () {
      const day = document.querySelector('input[name="day"]:checked');
      const slot = document.querySelector('input[name="slot"]:checked');

      if (day && slot) {
        const label = day.getAttribute("data-label") || "";
        const time = slot.getAttribute("value") || "";
        const parts = time.split("–");

        summary.textContent = label.charAt(0).toUpperCase() + label.slice(1) + " · " + parts[0] + ":00–" + parts[1] + ":00";

        confirmButton.removeAttribute("disabled");
      }
    });

    confirmButton.addEventListener("click", function () {
      confirmButton.textContent = "Booking modtaget ✓";
      confirmButton.setAttribute("disabled", "");
    });
  }
</script>

<style>
  /* ========== PAGE ========== */
  .studio {
    overflow-x: clip;
  }

  .btn-accent {
    background: var(--accent);
    color: #fff;
  }
  button.btn {
    font-family: inherit;
    cursor: pointer;
  }
  button.btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ========== HERO ========== */

  body {
    background: linear-gradient(to bottom, #fff, #fff, #ffc0ca);
    min-height: 100vh;
    margin: 0;
  }
  .cardcontainer {
    background-color: #fff;
    padding: 2rem;
    filter: drop-shadow(5px 5px 5px rgb(141, 138, 138));
    border-radius: 8%;
    border-left: 10px solid var(--red);
  }

  .studio-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: start;
    padding-block: 24px 96px;
  }

  .studio-media {
    grid-column: 1;
    grid-row: 1;
    padding: 180px 0 0 45px;
    min-height: 843px;
    --blob-top: -24px;
    --blob-left: -95px;
  }
  .studio-info {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 24px;
  }

  .back-btn {
    position: absolute;
    top: 0;
    left: -68px;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 4px #fff;
  }
  .back-btn:hover {
    background: var(--maroon);
  }

  .studio-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-l);
  }

  .studio-title {
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 0.9;
  }

  .studio-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-s);
  }
  .studio-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--green);
  }
  .studio-status-dot.is-off {
    background: transparent;
    border: 1.5px solid var(--ink);
  }

  .studio-description {
    font-size: var(--text-l);
    max-width: 52ch;
  }

  .studio-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    margin: 0;
    padding-block: 20px;
    border-block: 1px solid var(--line);
  }
  .studio-facts dt,
  .practical dt {
    font-size: var(--text-s);
    opacity: 0.7;
  }
  .studio-facts dd,
  .practical dd {
    margin: 0;
    font-weight: 700;
  }

  /* ========== SHEET ========== */
  .studio-sheet {
    position: relative;
    display: grid;
    gap: 80px;
    margin-bottom: 120px;
    padding: 56px;
    background: #fff;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-panel);
  }

  /* ========== BOOKING ========== */
  .booking {
    display: grid;
    gap: 24px;
    padding: 48px;
    background: var(--pink-light-alt);
    border-radius: var(--radius-l);
  }
  .booking-title {
    font-size: var(--text-3xl);
    font-weight: 600;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  /* The radio button is invisible but covers the whole label */
  .day,
  .slot {
    position: relative;
  }
  .day input,
  .slot input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* Datoer/days */
  .days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 16px;
  }
  .day-box {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 20px 8px;
    background: #fff;
    border-radius: var(--radius-s);
  }
  .day-name {
    font-size: var(--text-s);
  }
  .day-date {
    font-family: var(--serif);
    font-size: var(--text-3xl);
    line-height: 1;
  }

  .day input:checked + .day-box {
    background: var(--accent);
    color: #fff;
  }
  .day input:checked + .day-box .dot {
    background: #fff;
  }
  .day input:disabled + .day-box {
    color: #999999;
  }
  .day input:disabled {
    cursor: not-allowed;
  }
  .day input:focus-visible + .day-box {
    outline: 3px solid var(--maroon);
    outline-offset: 3px;
  }

  /* Dots */
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .dot.is-full {
    background: transparent;
    border: 1.5px solid currentColor;
  }

  .booking-legend {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .booking-legend .dot:last-of-type {
    margin-left: 12px;
  }

  /* Times */
  .slots {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .slot-box {
    display: block;
    padding: 10px 24px;
    background: #fff;
    border: 2px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-weight: 700;
  }

  .slot input:checked + .slot-box {
    background: var(--accent);
    color: #fff;
  }
  .slot input:disabled + .slot-box {
    background: #eeeeee;
    border-color: #eeeeee;
    color: #999999;
    text-decoration: line-through;
  }
  .slot input:disabled {
    cursor: not-allowed;
  }
  .slot input:focus-visible + .slot-box {
    outline: 3px solid var(--maroon);
    outline-offset: 3px;
  }

  /* Summary */
  .booking-summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 32px;
    background: #fff;
    border-radius: var(--radius-m);
  }
  .booking-choice {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  /* ========== UDSTYR + PRAKTISK ========== */
  .studio-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
  }
  .studio-h2 {
    margin-bottom: 16px;
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .udstyr-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .udstyr-list li {
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .practical {
    display: grid;
    gap: 20px;
    margin: 0 0 32px;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 10px 32px 10px 10px;
    background: url("/images/blobs/frederick-small.svg") no-repeat center / 100% 100%;
    color: var(--maroon);
  }
  .contact-pill img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
  }
  .contact-pill:hover strong {
    text-decoration: underline;
  }

  /* ========== MOBILE ========== */
  @media (max-width: 800px) {
    .studio-hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .studio-info,
    .studio-media {
      grid-column: 1;
    }
    .studio-media {
      grid-row: 1;
      padding: 90px 0 0 80px;
      min-height: 116vw;
      --blob-top: 0px;
      --blob-left: 0px;
      --blob-width: 90vw;
    }
    .studio-info {
      grid-row: 2;
      position: relative;
      z-index: 1;
    }
    .back-btn {
      left: 0;
    }

    .studio-sheet,
    .booking {
      padding: 24px;
    }
    .days {
      grid-template-columns: repeat(7, minmax(64px, 1fr));
      overflow-x: auto;
    }
    .studio-columns {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .studio-facts {
      gap: 24px;
    }
  }
</style>
